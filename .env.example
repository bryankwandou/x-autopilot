# X-Autopilot-Assistant Environment Configuration
# Copy this to .env

# OPENAI
OPENAI_API_KEY=your_openai_api_key_here

# X (TWITTER) AUTH
X_USERNAME=your_x_username
X_AUTH_TOKEN=your_auth_token_cookie
X_CT0=your_ct0_cookie

# THRESHOLDS
MIN_HYPE_SCORE=70
DAILY_REPLY_LIMIT=150
DAILY_POST_LIMIT=10

# INFRASTRUCTURE
DATABASE_URL=data/system.db
LOG_LEVEL=info
